{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"],
      "@migrations/*": ["src/migrations/*"],
      "@seeds/*": ["src/seeds/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "functions/**/*"],
  "exclude": ["node_modules", "dist"]
}
