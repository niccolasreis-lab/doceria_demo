# ==============================================================================
# DOCERIA DO SR GILMAR - VARIÁVEIS DE AMBIENTE (EXEMPLO)
# NUNCA versione credenciais ou chaves privadas (.env, .env.local, .env.production)
# ==============================================================================

# APPWRITE BACKEND
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=doceria-gilmar-prod
APPWRITE_DATABASE_ID=main_db
APPWRITE_API_KEY=YOUR_APPWRITE_SERVER_API_KEY_NEVER_EXPOSE_TO_CLIENT

# APPWRITE COLLECTIONS IDS
COLLECTION_PROFILES_ID=profiles
COLLECTION_PRODUTOS_ID=produtos
COLLECTION_MESAS_ID=mesas
COLLECTION_COMANDAS_ID=comandas
COLLECTION_ITENS_COMANDA_ID=itens_comanda
COLLECTION_PAGAMENTOS_ID=pagamentos
COLLECTION_FECHAMENTOS_CAIXA_ID=fechamentos_caixa
COLLECTION_NOTIFICACOES_ID=notificacoes

# WEB FRONTEND (Next.js - Variáveis Públicas)
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=doceria-gilmar-prod
NEXT_PUBLIC_APPWRITE_DATABASE_ID=main_db
NEXT_PUBLIC_PRINT_WIDTH_COLUMNS=48

# MOBILE EXPO (Expo Public Variables)
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
EXPO_PUBLIC_APPWRITE_PROJECT_ID=doceria-gilmar-prod
EXPO_PUBLIC_APPWRITE_DATABASE_ID=main_db

# IMPRESSORA TÉRMICA & HARDWARE (Opcional - Bridge de Impressão Local)
THERMAL_PRINTER_IP=192.168.1.200
THERMAL_PRINTER_PORT=9100
THERMAL_PRINTER_MODEL=ESC/POS_80MM
